#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
android_sdk_root="$HOME/.local/share/android-sdk"
java_home="$HOME/.local/share/jdks/temurin-11"
zig_home="$HOME/.local/share/zig/0.16.0"
setup_started=$SECONDS
step_started=$SECONDS
step_name=""

step() {
    if [[ -n "$step_name" ]]; then
        printf '<== %s completed in %ss\n' "$step_name" "$((SECONDS - step_started))"
    fi
    step_name="$1"
    step_started=$SECONDS
    printf '\n==> %s\n' "$1"
}

step "Installing required system packages"
packages=(ca-certificates curl git openjdk-17-jre-headless unzip xz-utils)
missing_packages=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'ok installed'; then
        missing_packages+=("$package")
    fi
done
if ((${#missing_packages[@]})); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "${missing_packages[@]}"
fi

# Zig 0.16 fails with ResolvConfParseFailed if resolv.conf has no trailing newline.
if [[ -s /etc/resolv.conf ]] &&
    [[ "$(tail -c 1 /etc/resolv.conf | od -An -t u1 | tr -d '[:space:]')" != "10" ]]; then
    printf '\n' | sudo tee -a /etc/resolv.conf >/dev/null
fi

case "$(uname -m)" in
    x86_64) java_arch="x64"; zig_arch="x86_64" ;;
    aarch64) java_arch="aarch64"; zig_arch="aarch64" ;;
    *) printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
esac

mkdir -p "$HOME/.local/bin" "$(dirname "$java_home")" \
    "$(dirname "$zig_home")" "$android_sdk_root"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

step "Installing Java 11"
if [[ ! -x "$java_home/bin/java" ]]; then
    curl --fail --location --retry 3 \
        "https://api.adoptium.net/v3/binary/latest/11/ga/linux/$java_arch/jdk/hotspot/normal/eclipse" \
        --output "$tmp_dir/java.tar.gz"
    mkdir -p "$java_home"
    tar -xzf "$tmp_dir/java.tar.gz" --strip-components=1 -C "$java_home"
fi

step "Installing Zig 0.16.0"
if [[ ! -x "$zig_home/zig" ]]; then
    curl --fail --location --retry 3 \
        "https://ziglang.org/download/0.16.0/zig-$zig_arch-linux-0.16.0.tar.xz" \
        --output "$tmp_dir/zig.tar.xz"
    mkdir -p "$zig_home"
    tar -xJf "$tmp_dir/zig.tar.xz" --strip-components=1 -C "$zig_home"
fi
ln -sfn "$zig_home/zig" "$HOME/.local/bin/zig"

step "Installing Android command-line tools"
sdkmanager="$android_sdk_root/cmdline-tools/latest/bin/sdkmanager"
if [[ ! -x "$sdkmanager" ]]; then
    curl --fail --location --retry 3 \
        "https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip" \
        --output "$tmp_dir/android-command-line-tools.zip"
    rm -rf "$android_sdk_root/cmdline-tools/latest"
    mkdir -p "$android_sdk_root/cmdline-tools"
    unzip -q "$tmp_dir/android-command-line-tools.zip" -d "$tmp_dir/android"
    mv "$tmp_dir/android/cmdline-tools" "$android_sdk_root/cmdline-tools/latest"
fi

step "Installing required Android SDK components"
sdk_java_home="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
if [[ "$("$sdk_java_home/bin/java" -version 2>&1)" != *'version "17.'* ]]; then
    sdk_java_home="/usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture)"
fi
sdk_packages=()
[[ -x "$android_sdk_root/platform-tools/adb" ]] || sdk_packages+=("platform-tools")
[[ -f "$android_sdk_root/platforms/android-30/android.jar" ]] || \
    sdk_packages+=("platforms;android-30")
[[ -x "$android_sdk_root/build-tools/30.0.3/aapt" ]] || \
    sdk_packages+=("build-tools;30.0.3")
# Android Gradle Plugin 4.2.2 uses this NDK for termux-shared's ndkBuild project.
[[ -d "$android_sdk_root/ndk/21.4.7075529/toolchains/llvm/prebuilt" ]] || \
    sdk_packages+=("ndk;21.4.7075529")
[[ -d "$android_sdk_root/ndk/29.0.14206865/toolchains/llvm/prebuilt" ]] || \
    sdk_packages+=("ndk;29.0.14206865")
[[ -x "$android_sdk_root/cmake/3.22.1/bin/cmake" ]] || \
    sdk_packages+=("cmake;3.22.1")
if ((${#sdk_packages[@]})); then
    yes 2>/dev/null | JAVA_HOME="$sdk_java_home" PATH="$sdk_java_home/bin:$PATH" \
        "$sdkmanager" --sdk_root="$android_sdk_root" --licenses >/dev/null || true
    JAVA_HOME="$sdk_java_home" PATH="$sdk_java_home/bin:$PATH" \
        "$sdkmanager" --sdk_root="$android_sdk_root" "${sdk_packages[@]}"
else
    printf 'All required Android SDK components are already installed.\n'
fi

step "Persisting the orb toolchain environment"
environment_file="$HOME/.config/termux-app-ghostty/env.sh"
mkdir -p "$(dirname "$environment_file")"
cat > "$environment_file" <<EOF
export JAVA_HOME="$java_home"
export ANDROID_HOME="$android_sdk_root"
export ANDROID_SDK_ROOT="$android_sdk_root"
export ANDROID_NDK_HOME="$android_sdk_root/ndk/29.0.14206865"
export ANDROID_NDK_ROOT="\$ANDROID_NDK_HOME"
export PATH="\$JAVA_HOME/bin:\$ANDROID_SDK_ROOT/platform-tools:\$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$zig_home:\$HOME/.local/bin:\$PATH"
EOF

profile_source="source \"$environment_file\" # termux-app-ghostty orb toolchain"
if ! grep -Fqx "$profile_source" "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n%s\n' "$profile_source" >> "$HOME/.bash_profile"
fi

export JAVA_HOME="$java_home"
export ANDROID_HOME="$android_sdk_root"
export ANDROID_SDK_ROOT="$android_sdk_root"
export ANDROID_NDK_HOME="$android_sdk_root/ndk/29.0.14206865"
export ANDROID_NDK_ROOT="$ANDROID_NDK_HOME"
export PATH="$JAVA_HOME/bin:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$zig_home:$HOME/.local/bin:$PATH"

step "Warming Gradle and verifying project configuration"
cd "$repo_root"
./gradlew --no-daemon help

step "Orb setup complete"
printf 'Total setup time: %ss\n' "$((SECONDS - setup_started))"
