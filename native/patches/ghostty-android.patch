+test "clipboard_read randomized round trips" {
+    var t: Terminal = try .init(testing.allocator, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(testing.allocator);
+
+    const S = struct {
+        var contents: []const u8 = "";
+        var written: ?[]u8 = null;
+
+        fn deinit() void {
+            if (written) |value| testing.allocator.free(value);
+            written = null;
+        }
+
+        fn clipboardRead(_: *Handler, _: clipboard.Location) ?[]const u8 {
+            return contents;
+        }
+
+        fn writePty(_: *Handler, data: [:0]const u8) void {
+            deinit();
+            written = testing.allocator.dupe(u8, data) catch @panic("OOM");
+        }
+    };
+    S.contents = "";
+    S.written = null;
+    defer S.deinit();
+
+    var handler: Handler = .init(&t);
+    handler.effects.clipboard_read = &S.clipboardRead;
+    handler.effects.write_pty = &S.writePty;
+
+    var s: Stream = .initAlloc(testing.allocator, handler);
+    defer s.deinit();
+
+    var prng = std.Random.DefaultPrng.init(0x52c1a0b);
+    const random = prng.random();
+    var data: [4096]u8 = undefined;
+    var expected: [std.base64.standard.Encoder.calcSize(data.len) + 9]u8 =
+        undefined;
+    const selectors = [_]u8{ 'c', 's', 'p', 'q', '0' };
+
+    for (0..5000) |_| {
+        const len = random.intRangeAtMost(usize, 0, data.len);
+        random.bytes(data[0..len]);
+        S.contents = data[0..len];
+
+        const requested = selectors[random.uintLessThan(usize, selectors.len)];
+        const normalized: u8 = switch (requested) {
+            's' => 's',
+            'p' => 'p',
+            else => 'c',
+        };
+        const sequence = [_]u8{
+            '\x1B', ']', '5', '2', ';', requested, ';', '?', '\x1B', '\\',
+        };
+        var offset: usize = 0;
+        while (offset < sequence.len) {
+            const count = random.intRangeAtMost(
+                usize,
+                1,
+                sequence.len - offset,
+            );
+            s.nextSlice(sequence[offset..][0..count]);
+            offset += count;
+        }
+
+        const encoded_len = std.base64.standard.Encoder.calcSize(len);
+        const prefix = try std.fmt.bufPrint(
+            &expected,
+            "\x1B]52;{c};",
+            .{normalized},
+        );
+        _ = std.base64.standard.Encoder.encode(
+            expected[prefix.len .. prefix.len + encoded_len],
+            data[0..len],
+        );
+        expected[prefix.len + encoded_len] = '\x1B';
+        expected[prefix.len + encoded_len + 1] = '\\';
+        try testing.expectEqualSlices(
+            u8,
+            expected[0 .. prefix.len + encoded_len + 2],
+            S.written.?,
+        );
+    }
+}
