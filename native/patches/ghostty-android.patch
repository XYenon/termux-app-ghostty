@@ -585,6 +603,69 @@ pub fn placement_render_info(
     return .success;
 }
 
+pub fn virtual_placements(
+    terminal_: terminal_c.Terminal,
+    out: ?[*]VirtualPlacementRenderInfo,
+    capacity: usize,
+    out_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const t = terminal_c.zigTerminal(terminal_) orelse return .invalid_value;
+    const count_out = out_count orelse return .invalid_value;
+    count_out.* = 0;
+    if (t.cols == 0 or t.rows == 0 or t.width_px == 0 or t.height_px == 0)
+        return .success;
+
+    const pages = &t.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const bottom = pages.getBottomRight(.viewport) orelse return .success;
+    const cell_width = t.width_px / t.cols;
+    const cell_height = t.height_px / t.rows;
+    if (cell_width == 0 or cell_height == 0) return .success;
+
+    const storage = &t.screens.active.kitty_images;
+    var iterator = kitty_unicode.placementIterator(top, bottom);
+    var count: usize = 0;
+    while (iterator.next()) |placement| {
+        const image = storage.imageById(placement.image_id) orelse continue;
+        const render = placement.renderPlacement(
+            storage,
+            &image,
+            cell_width,
+            cell_height,
+        ) catch continue;
+        if (render.dest_width == 0 or render.dest_height == 0) continue;
+        const viewport = pages.pointFromPin(.viewport, render.top_left) orelse
+            continue;
+
+        if (out) |items| {
+            if (count < capacity) {
+                if (items[count].size < @sizeOf(VirtualPlacementRenderInfo))
+                    return .invalid_value;
+                items[count] = .{
+                    .image_id = placement.image_id,
+                    .viewport_col = @intCast(render.top_left.x),
+                    .viewport_row = @intCast(viewport.viewport.y),
+                    .offset_x = render.offset_x,
+                    .offset_y = render.offset_y,
+                    .pixel_width = render.dest_width,
+                    .pixel_height = render.dest_height,
+                    .source_x = render.source_x,
+                    .source_y = render.source_y,
+                    .source_width = render.source_width,
+                    .source_height = render.source_height,
+                };
+            }
+        }
+        count += 1;
+    }
+
+    count_out.* = count;
+    if (count > capacity or (out == null and count > 0)) return .out_of_space;
+    return .success;
+}
