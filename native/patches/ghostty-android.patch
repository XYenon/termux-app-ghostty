+pub fn virtual_placements(
+    terminal_: terminal_c.Terminal,
+    out: ?[*]VirtualPlacementRenderInfo,
+    capacity: usize,
+    out_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const t = terminal_c.zigTerminal(terminal_) orelse return .invalid_value;
+    const count_out = out_count orelse return .invalid_value;
+    count_out.* = 0;
+    if (t.cols == 0 or t.rows == 0 or t.width_px == 0 or t.height_px == 0)
+        return .success;
+
+    const pages = &t.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const bottom = pages.getBottomRight(.viewport) orelse return .success;
+    const cell_width = t.width_px / t.cols;
+    const cell_height = t.height_px / t.rows;
+    if (cell_width == 0 or cell_height == 0) return .success;
+
+    const storage = &t.screens.active.kitty_images;
+    var iterator = kitty_unicode.placementIterator(top, bottom);
+    var count: usize = 0;
+    while (iterator.next()) |placement| {
+        const image = storage.imageById(placement.image_id) orelse continue;
+        const render = placement.renderPlacement(
+            storage,
+            &image,
+            cell_width,
+            cell_height,
+        ) catch continue;
+        if (render.dest_width == 0 or render.dest_height == 0) continue;
+        const viewport = pages.pointFromPin(.viewport, render.top_left) orelse
+            continue;
+
+        if (out) |items| {
+            if (count < capacity) {
+                if (items[count].size < @sizeOf(VirtualPlacementRenderInfo))
+                    return .invalid_value;
+                items[count] = .{
+                    .image_id = placement.image_id,
+                    .viewport_col = @intCast(render.top_left.x),
+                    .viewport_row = @intCast(viewport.viewport.y),
+                    .offset_x = render.offset_x,
+                    .offset_y = render.offset_y,
+                    .pixel_width = render.dest_width,
+                    .pixel_height = render.dest_height,
+                    .source_x = render.source_x,
+                    .source_y = render.source_y,
+                    .source_width = render.source_width,
+                    .source_height = render.source_height,
+                };
+            }
+        }
+        count += 1;
+    }
+
+    // Relative placements rooted at virtual placements use the minimum
+    // visible placeholder cell of the root as their origin. Iterate the
+    // placeholders for each relative chain to avoid allocating an origin map
+    // in this caller-buffer API.
+    var placement_iterator = storage.placements.iterator();
+    while (placement_iterator.next()) |entry| {
+        const relative = switch (entry.value_ptr.location) {
+            .relative => |value| value,
+            .pin, .virtual => continue,
+        };
+        const chain = storage.resolveChain(relative) orelse continue;
+        if (chain.root.location != .virtual) continue;
+
+        var origin_col: ?u32 = null;
+        var origin_row: ?u32 = null;
+        var placeholder_iterator = kitty_unicode.placementIterator(top, bottom);
+        while (placeholder_iterator.next()) |placeholder| {
+            const target = storage.placeholderTarget(
+                placeholder.image_id,
+                placeholder.placement_id,
+            ) orelse continue;
+            if (!target.key.eql(chain.root_key)) continue;
+            const viewport = pages.pointFromPin(.viewport, placeholder.pin) orelse
+                continue;
+            origin_col = @min(origin_col orelse viewport.viewport.x, viewport.viewport.x);
+            origin_row = @min(origin_row orelse viewport.viewport.y, viewport.viewport.y);
+        }
+
+        const image = storage.imageById(entry.key_ptr.image_id) orelse continue;
+        const grid = entry.value_ptr.gridSize(image, t);
+        if (grid.cols == 0 or grid.rows == 0) continue;
+        const viewport_col = @as(i64, origin_col orelse continue) +
+            chain.horizontal_offset;
+        const viewport_row = @as(i64, origin_row orelse continue) +
+            chain.vertical_offset;
+        if (viewport_col >= t.cols or viewport_col + grid.cols - 1 < 0) continue;
+        if (viewport_row >= t.rows or viewport_row + grid.rows - 1 < 0) continue;
+        const resolved_col = std.math.cast(i32, viewport_col) orelse continue;
+        const resolved_row = std.math.cast(i32, viewport_row) orelse continue;
+
+        const pixel = entry.value_ptr.pixelSize(image, t);
+        if (pixel.width == 0 or pixel.height == 0) continue;
+        const offset = entry.value_ptr.cellOffset(t);
+        const source = entry.value_ptr.sourceRect(image);
+        if (out) |items| {
+            if (count < capacity) {
+                if (items[count].size < @sizeOf(VirtualPlacementRenderInfo))
+                    return .invalid_value;
+                items[count] = .{
+                    .image_id = entry.key_ptr.image_id,
+                    .viewport_col = resolved_col,
+                    .viewport_row = resolved_row,
+                    .offset_x = offset.x,
+                    .offset_y = offset.y,
+                    .pixel_width = pixel.width,
+                    .pixel_height = pixel.height,
+                    .source_x = source.x,
+                    .source_y = source.y,
+                    .source_width = source.width,
+                    .source_height = source.height,
+                    .z = entry.value_ptr.z,
+                };
+            }
+        }
+        count += 1;
+    }
+
+    count_out.* = count;
+    if (count > capacity or (out == null and count > 0)) return .out_of_space;
+    return .success;
+}
+
+pub fn animation_tick(
+    terminal_: terminal_c.Terminal,
+    now_ms: u64,
+    out_delay_ms: ?*u64,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const t = terminal_c.zigTerminal(terminal_) orelse return .invalid_value;
+    const io = terminal_c.zigIo(terminal_) orelse return .invalid_value;
+    const delay_out = out_delay_ms orelse return .invalid_value;
+    const delay = t.screens.active.kitty_images.animationTick(io, now_ms) orelse
+        return .no_value;
+    delay_out.* = delay;
+    return .success;
+}
