diff --git a/src/terminal/Terminal.zig b/src/terminal/Terminal.zig
index 30424fc2e..72020fff4 100644
--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -96,6 +96,9 @@ mouse_shape: mouse.Shape = .text,
 /// Per-session Glyph Protocol registrations.
 glyph_glossary: glyph.Glossary = .empty,

+/// Monotonically increasing generation for renderer cache invalidation.
+glyph_glossary_generation: u64 = 0,
+
 /// Kitty drag and drop protocol (OSC 72) state. Allocated when a client
 /// registers to accept drops (t=a) and freed when it unregisters (t=A),
 /// so a terminal that never runs a drag and drop aware program pays
@@ -741,6 +744,9 @@ fn printSliceFast(
     grapheme_cluster: bool,
     allow_unicode: bool,
 ) !usize {
+    // Glyph Protocol registrations can override Unicode cell widths.
+    if (self.glyph_glossary.entries.count() > 0) return 0;
+
     // Printable ASCII is always narrow and eligible.
     if (comptime Cp == u8) return self.printSliceFill(
         .narrow,
@@ -2129,7 +2135,12 @@ pub fn print(self: *Terminal, c: u21) !void {
     // non-single-width characters properly. We have a fast-path for
     // byte-sized characters since they're so common. We can ignore
     // control characters because they're always filtered prior.
-    const width: usize = if (c <= 0xFF) 1 else @intCast(unicode.table.get(c).width);
+    const width: usize = if (self.glyph_glossary.entries.get(c)) |entry|
+        @backingInt(entry.width)
+    else if (c <= 0xFF)
+        1
+    else
+        @intCast(unicode.table.get(c).width);

     // Note: it is possible to have a width of "3" and a width of "-1" from
     // uucode.x's wcwidth. We should look into those cases and handle them
@@ -4680,7 +4691,13 @@ pub fn glyphProtocol(
 ) ?glyph.Response {
     const resp = glyph.execute(alloc, &self.glyph_glossary, req);
     switch (req.*) {
-        .register, .clear => self.flags.dirty.glyph_glossary = true,
+        .register, .clear => {
+            self.flags.dirty.glyph_glossary = true;
+            self.glyph_glossary_generation +%= 1;
+            if (self.glyph_glossary_generation == 0) {
+                self.glyph_glossary_generation = 1;
+            }
+        },
         .support, .query => {},
     }
     return resp;
@@ -5893,6 +5910,10 @@ pub fn fullReset(self: *Terminal) void {
     self.pwd.clearRetainingCapacity();
     self.title.clearRetainingCapacity();
     self.glyph_glossary.clearAndFree(self.gpa());
+    self.glyph_glossary_generation +%= 1;
+    if (self.glyph_glossary_generation == 0) {
+        self.glyph_glossary_generation = 1;
+    }
     // A reset only interrupts an in-progress chunked OSC 72 command;
     // drag and drop registration survives, matching kitty.
     if (self.kitty_dnd) |dnd| dnd.chunking = .{};
diff --git a/src/terminal/c/glyph.zig b/src/terminal/c/glyph.zig
new file mode 100644
index 000000000..2f958c03d
--- /dev/null
+++ b/src/terminal/c/glyph.zig
@@ -0,0 +1,177 @@
+const std = @import("std");
+const lib = @import("../lib.zig");
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+
+/// C: GhosttyGlyphConstraintSize
+pub const ConstraintSize = enum(c_int) {
+    none = 0,
+    fit = 1,
+    cover = 2,
+    fit_cover_one = 3,
+    stretch = 4,
+};
+
+/// C: GhosttyGlyphConstraintAlign
+pub const ConstraintAlign = enum(c_int) {
+    none = 0,
+    start = 1,
+    end = 2,
+    center = 3,
+    center_one = 4,
+};
+
+/// C: GhosttyGlyphInfo
+pub const Info = extern struct {
+    pub const sized_base = "point_count";
+
+    size: usize = @sizeOf(Info),
+    units_per_em: u32 = 0,
+    advance_width: u32 = 0,
+    line_height: u32 = 0,
+    cell_width: u8 = 0,
+    constraint_size: ConstraintSize = .none,
+    align_horizontal: ConstraintAlign = .none,
+    align_vertical: ConstraintAlign = .none,
+    pad_top: f64 = 0,
+    pad_right: f64 = 0,
+    pad_bottom: f64 = 0,
+    pad_left: f64 = 0,
+    contour_count: usize = 0,
+    point_count: usize = 0,
+};
+
+/// C: GhosttyGlyphPoint
+pub const Point = extern struct {
+    x: i32,
+    y: i32,
+    on_curve: bool,
+};
+
+pub fn generation(
+    terminal_: terminal_c.Terminal,
+    out: ?*u64,
+    out_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const terminal = terminal_c.zigTerminal(terminal_) orelse
+        return .invalid_value;
+    (out orelse return .invalid_value).* = terminal.glyph_glossary_generation;
+    if (out_count) |count| count.* = terminal.glyph_glossary.entries.count();
+    return .success;
+}
+
+pub fn info(
+    terminal_: terminal_c.Terminal,
+    codepoint: u32,
+    out_: ?*Info,
+) callconv(lib.calling_conv) Result {
+    const terminal = terminal_c.zigTerminal(terminal_) orelse
+        return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (!lib.sizedCheck(.output, out)) return .invalid_value;
+    if (codepoint > std.math.maxInt(u21)) return .invalid_value;
+
+    const entry = terminal.glyph_glossary.entries.get(@intCast(codepoint)) orelse
+        return .no_value;
+    const outline = switch (entry.glyph) {
+        .glyf => |value| value,
+    };
+    lib.sizedWrite(out, .{
+        .units_per_em = entry.design.units_per_em,
+        .advance_width = entry.design.advance_width,
+        .line_height = entry.design.line_height,
+        .cell_width = @backingInt(entry.width),
+        .constraint_size = @fromBackingInt(@backingInt(entry.constraint.size)),
+        .align_horizontal = @fromBackingInt(@backingInt(entry.constraint.align_horizontal)),
+        .align_vertical = @fromBackingInt(@backingInt(entry.constraint.align_vertical)),
+        .pad_top = entry.constraint.pad_top,
+        .pad_right = entry.constraint.pad_right,
+        .pad_bottom = entry.constraint.pad_bottom,
+        .pad_left = entry.constraint.pad_left,
+        .contour_count = outline.contours.len,
+        .point_count = outline.points.len,
+    });
+    return .success;
+}
+
+pub fn contours(
+    terminal_: terminal_c.Terminal,
+    codepoint: u32,
+    out: ?[*]u16,
+    capacity: usize,
+    out_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const terminal = terminal_c.zigTerminal(terminal_) orelse
+        return .invalid_value;
+    if (codepoint > std.math.maxInt(u21)) return .invalid_value;
+    const entry = terminal.glyph_glossary.entries.get(@intCast(codepoint)) orelse
+        return .no_value;
+    const outline = switch (entry.glyph) {
+        .glyf => |value| value,
+    };
+    if (out_count) |count| count.* = outline.contours.len;
+    if (capacity < outline.contours.len or out == null) return .out_of_space;
+    @memcpy(out.?[0..outline.contours.len], outline.contours);
+    return .success;
+}
+
+pub fn points(
+    terminal_: terminal_c.Terminal,
+    codepoint: u32,
+    out: ?[*]Point,
+    capacity: usize,
+    out_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const terminal = terminal_c.zigTerminal(terminal_) orelse
+        return .invalid_value;
+    if (codepoint > std.math.maxInt(u21)) return .invalid_value;
+    const entry = terminal.glyph_glossary.entries.get(@intCast(codepoint)) orelse
+        return .no_value;
+    const outline = switch (entry.glyph) {
+        .glyf => |value| value,
+    };
+    if (out_count) |count| count.* = outline.points.len;
+    if (capacity < outline.points.len or out == null) return .out_of_space;
+    for (outline.points, out.?[0..outline.points.len]) |src, *dst| {
+        dst.* = .{ .x = src.x, .y = src.y, .on_curve = src.on_curve };
+    }
+    return .success;
+}
+
+test "glyph width survives ASCII and mixed-width print paths and reset" {
+    if (comptime !@import("terminal_options").glyph_protocol) return error.SkipZigTest;
+    const testing = std.testing;
+    var terminal: terminal_c.Terminal = null;
+    try testing.expectEqual(.success, terminal_c.new(&lib.alloc.test_allocator, &terminal, 20, 4));
+    defer terminal_c.free(terminal);
+    const enabled = true;
+    try testing.expectEqual(.success, terminal_c.set(terminal, .glyph_protocol, &enabled));
+
+    const registration = "\x1b_25a1;r;cp=e0a0;width=2;AAAAAAAAAAAAAA==\x1b\\";
+    terminal_c.vt_write(terminal, registration, registration.len);
+    var initial: u64 = 0;
+    var count: usize = 0;
+    try testing.expectEqual(.success, generation(terminal, &initial, &count));
+    try testing.expectEqual(1, count);
+    var value: Info = .{};
+    try testing.expectEqual(.success, info(terminal, 0xE0A0, &value));
+    try testing.expectEqual(2, value.cell_width);
+
+    // ASCII takes the new u8 path, while alternating widths can take the
+    // mixed u32 path. Both must honor the registered PUA's two-cell width.
+    const text = "ab\u{e0a0}c\u{4e2d}\u{e0a0}";
+    terminal_c.vt_write(terminal, text, text.len);
+    var x: u16 = 0;
+    try testing.expectEqual(.success, terminal_c.get(terminal, .cursor_x, &x));
+    try testing.expectEqual(9, x);
+
+    terminal_c.reset(terminal);
+    var after: u64 = 0;
+    try testing.expectEqual(.success, generation(terminal, &after, &count));
+    try testing.expect(after > initial);
+    try testing.expectEqual(0, count);
+    try testing.expectEqual(.no_value, info(terminal, 0xE0A0, &value));
+    terminal_c.vt_write(terminal, text, text.len);
+    try testing.expectEqual(.success, terminal_c.get(terminal, .cursor_x, &x));
+    try testing.expectEqual(7, x);
+}
