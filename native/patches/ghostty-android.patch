index 000000000..898c82728
--- /dev/null
+++ b/include/ghostty/vt/glyph.h
@@ -0,0 +1,93 @@
+/**
+ * @file glyph.h
+ *
+ * Read-only access to Glyph Protocol registrations for custom renderers.
+ */
+
+#ifndef GHOSTTY_VT_GLYPH_H
+#define GHOSTTY_VT_GLYPH_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <ghostty/vt/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum GHOSTTY_ENUM_TYPED {
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_NONE = 0,
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_FIT = 1,
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_COVER = 2,
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_FIT_COVER_ONE = 3,
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_STRETCH = 4,
+  GHOSTTY_GLYPH_CONSTRAINT_SIZE_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
+} GhosttyGlyphConstraintSize;
+
+typedef enum GHOSTTY_ENUM_TYPED {
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_NONE = 0,
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_START = 1,
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_END = 2,
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_CENTER = 3,
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_CENTER_ONE = 4,
+  GHOSTTY_GLYPH_CONSTRAINT_ALIGN_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
+} GhosttyGlyphConstraintAlign;
+
+typedef struct {
+  size_t size;
+  uint32_t units_per_em;
+  uint32_t advance_width;
+  uint32_t line_height;
+  uint8_t cell_width;
+  GhosttyGlyphConstraintSize constraint_size;
+  GhosttyGlyphConstraintAlign align_horizontal;
+  GhosttyGlyphConstraintAlign align_vertical;
+  double pad_top;
+  double pad_right;
+  double pad_bottom;
+  double pad_left;
+  size_t contour_count;
+  size_t point_count;
+} GhosttyGlyphInfo;
+
+typedef struct {
+  int32_t x;
+  int32_t y;
+  bool on_curve;
+} GhosttyGlyphPoint;
+
+/**
+ * Get the glossary generation, which changes on every register, clear, and
+ * full reset. When out_count is non-NULL it receives the number of currently
+ * registered glyphs so renderers can skip per-cell lookups when it is zero.
+ */
+GHOSTTY_API GhosttyResult ghostty_glyph_generation(
+    GhosttyTerminal terminal,
+    uint64_t* out_generation,
+    size_t* out_count);
+
+GHOSTTY_API GhosttyResult ghostty_glyph_info(
+    GhosttyTerminal terminal,
+    uint32_t codepoint,
+    GhosttyGlyphInfo* out_info);
+
+GHOSTTY_API GhosttyResult ghostty_glyph_contours(
+    GhosttyTerminal terminal,
+    uint32_t codepoint,
+    uint16_t* out_contours,
+    size_t capacity,
+    size_t* out_count);
+
+GHOSTTY_API GhosttyResult ghostty_glyph_points(
+    GhosttyTerminal terminal,
+    uint32_t codepoint,
+    GhosttyGlyphPoint* out_points,
+    size_t capacity,
+    size_t* out_count);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GHOSTTY_VT_GLYPH_H */
